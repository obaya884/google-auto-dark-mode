{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "0.0.1",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://docs.google.com/spreadsheets/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
